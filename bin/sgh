#!/bin/sh
# shellcheck shell=dash
# shellcheck disable=SC2016  # this program prints shell code; $ must stay literal
#
# sgh — a different GitHub account in every terminal.
#
# gh keeps one active account in ~/.config/gh/hosts.yml, so `gh auth switch` changes
# the account in EVERY terminal at once. sgh gives each account its own gh config dir
# and selects it with $GH_CONFIG_DIR, which is per-process — so two terminals can hold
# two different GitHub identities at the same time.
#
# `switch` is the one command that has to reach back into the calling shell, which no
# child process can do. `sgh init <shell>` prints a small function that wraps this
# executable and evals what `__shellcode` prints. Everything else runs as a normal
# subprocess.
#
# https://github.com/lenixbyte/sgh — MIT licensed.

SGH_VERSION="0.1.0"
SGH_HOME="${SGH_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/sgh}"
SGH_COMMANDS="list switch who add delete default exec import path init completions help version"

# ── paths ─────────────────────────────────────────────────────────────

profile_dir() { printf '%s' "$SGH_HOME/profiles/$1"; }
gh_dir() { printf '%s' "$SGH_HOME/profiles/$1/gh"; }
gh_config() { printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/gh"; }
err() { printf 'sgh: %s\n' "$*" >&2; }

colors() {
	if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
		B=$(printf '\033[1m')
		D=$(printf '\033[2m')
		O=$(printf '\033[0m')
	else
		B='' D='' O=''
	fi
}

tilde() {
	case "$1" in
	"$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
	*) printf '%s' "$1" ;;
	esac
}

# Quote a value for safe eval in a POSIX shell, and for fish, whose single quotes
# escape differently. Paths come from $HOME and can contain anything.
shquote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
fishquote() { printf "'%s'" "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e "s/'/\\\\'/g")"; }

# Profile names become directory names, so keep them boring. This is also what stops
# `sgh delete ../../..` from being interesting.
valid_name() {
	case "$1" in
	"" | . | ..) return 1 ;;
	*[!A-Za-z0-9._-]*) return 1 ;;
	esac
	return 0
}

exists() { [ -d "$(profile_dir "$1")" ]; }

require_gh() {
	command -v gh >/dev/null 2>&1 && return 0
	err "the GitHub CLI (gh) is not installed — see https://cli.github.com"
	return 1
}

# ── reading gh's config ───────────────────────────────────────────────

# Print "<login> <host>" for every account in a gh config dir by reading hosts.yml
# directly. Parsing beats shelling out to `gh auth status`, which makes a network call
# per account and would make `sgh list` feel slow.
accounts() {
	f="$1/hosts.yml"
	[ -f "$f" ] || return 0
	awk '
		function ind(s) { match(s, /^[ \t]*/); return RLENGTH }
		/^[ \t]*$/ { next }
		/^[^ \t#]/ { host = $1; sub(/:$/, "", host); uind = -1; cind = -1; next }
		host == "" { next }
		{
			i = ind($0); key = $1; sub(/:$/, "", key)
			if (key == "users" && uind < 0) { uind = i; next }
			if (uind < 0) next
			if (i <= uind) { uind = -1; cind = -1; next }   # left the users block
			if (cind < 0) cind = i
			# Direct children of users: are the logins; anything deeper belongs to
			# that login (oauth_token, git_protocol, ...).
			if (i == cind && $0 ~ /:[ \t]*$/) print key, host
		}
	' "$f" | sort -u
}

# "octocat", or "octocat, admin@github.acme.com" when more than one host is in play.
summary() {
	accounts "$(gh_dir "$1")" | awk '
		{ one = ($2 == "github.com") ? $1 : $1 "@" $2
		  line = (line == "") ? one : line ", " one }
		END { print (line == "") ? "—" : line }
	'
}

# gh stores tokens in the OS keyring by default, but falls back to writing oauth_token
# into hosts.yml. If this account is one of those, the token has to come along or the
# new profile would be logged out.
token_in_file() {
	src="$1" host="$2" login="$3"
	[ -f "$src" ] || return 0
	awk -v HOST="$host" -v LOGIN="$login" '
		function ind(s) { match(s, /^[ \t]*/); return RLENGTH }
		/^[^ \t#]/ { h = $1; sub(/:$/, "", h); inhost = (h == HOST); uind = -1; lind = -1; next }
		!inhost { next }
		{
			i = ind($0); key = $1; sub(/:$/, "", key)
			if (key == "users" && uind < 0) { uind = i; next }
			if (lind >= 0 && i <= lind) lind = -1
			if (uind >= 0 && lind < 0 && i > uind && key == LOGIN && $0 ~ /:[ \t]*$/) { lind = i; next }
			if (lind >= 0 && i > lind && key == "oauth_token") { print $2; exit }
		}
	' "$src"
}

default_profile() {
	[ -f "$SGH_HOME/default" ] || return 0
	head -n 1 "$SGH_HOME/default" 2>/dev/null
}

# find, not a glob: zsh's nomatch would make `profiles/*` an error rather than an empty
# list when no profiles exist yet, and this output is eval'd by the caller's shell.
list_names() {
	[ -d "$SGH_HOME/profiles" ] || return 0
	find "$SGH_HOME/profiles" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
		while IFS= read -r p; do printf '%s\n' "${p##*/}"; done | sort
}

write_hosts() {
	# $1=gh dir  $2=login  $3=host  $4=token (optional)
	{
		printf '%s:\n' "$3"
		printf '    git_protocol: https\n'
		printf '    users:\n'
		printf '        %s:\n' "$2"
		[ -n "$4" ] && printf '            oauth_token: %s\n' "$4"
		printf '    user: %s\n' "$2"
	} >"$1/hosts.yml"
	chmod 600 "$1/hosts.yml" 2>/dev/null
	return 0
}

# Build a profile around an account already authenticated somewhere in the user's gh
# setup — the token is reused, so there is nothing to log in to.
link_profile() {
	name="$1" login="$2" host="$3"
	d="$(gh_dir "$name")"
	mkdir -p "$d" || return 1
	chmod 700 "$(profile_dir "$name")" 2>/dev/null

	# Carry over aliases/editor settings so a new profile is not a factory reset.
	src="$(gh_config)/config.yml"
	[ -f "$src" ] && [ ! -f "$d/config.yml" ] && cp "$src" "$d/config.yml"

	tok="$(token_in_file "$(gh_config)/hosts.yml" "$host" "$login")"
	write_hosts "$d" "$login" "$host" "$tok"
}

# ── commands ──────────────────────────────────────────────────────────

cmd_list() {
	names="$(list_names)"
	if [ -z "$names" ]; then
		printf 'No profiles yet.\n\n'
		printf '  sgh import          turn your existing gh logins into profiles\n'
		printf '  sgh add <name>      log in to a new account\n'
		return 0
	fi

	colors
	def="$(default_profile)"
	printf '%s  %-16s %-30s%s\n' "$D" "PROFILE" "ACCOUNT" "$O"

	printf '%s\n' "$names" | while IFS= read -r n; do
		[ -n "$n" ] || continue
		tag=''
		[ "$n" = "$def" ] && tag='default'
		if [ "$n" = "${SGH_PROFILE:-}" ]; then
			printf '%s* %-16s %-30s%s%s\n' "$B" "$n" "$(summary "$n")" "$tag" "$O"
		else
			printf '  %-16s %-30s%s%s%s\n' "$n" "$(summary "$n")" "$D" "$tag" "$O"
		fi
	done

	printf '\n%s* = active in this terminal%s\n' "$D" "$O"
	return 0
}

cmd_who() {
	if [ "${1:-}" = "-q" ] || [ "${1:-}" = "--quiet" ]; then
		[ -n "${SGH_PROFILE:-}" ] && printf '%s\n' "$SGH_PROFILE"
		return 0
	fi

	if [ -z "${SGH_PROFILE:-}" ]; then
		printf 'No profile active in this terminal (using the default gh config).\n'
		[ -n "$(list_names)" ] && printf 'Pick one with: sgh switch <name>\n'
		return 0
	fi

	colors
	printf '%s%s%s → %s\n' "$B" "$SGH_PROFILE" "$O" "$(summary "$SGH_PROFILE")"
	printf '%s%s%s\n' "$D" "$(tilde "${GH_CONFIG_DIR:-}")" "$O"
	return 0
}

cmd_add() {
	name="${1:-}" link='' host='github.com'
	[ $# -gt 0 ] && shift

	if ! valid_name "$name"; then
		err "usage: sgh add <name> [--link <login>] [--host <host>] [gh auth login flags...]"
		return 1
	fi
	if exists "$name"; then
		err "profile '$name' already exists"
		return 1
	fi
	require_gh || return 1

	while [ $# -gt 0 ]; do
		case "$1" in
		--link)
			link="${2:-}"
			shift 2 || break
			;;
		--host | --hostname)
			host="${2:-}"
			shift 2 || break
			;;
		*) break ;;
		esac
	done

	if [ -n "$link" ]; then
		link_profile "$name" "$link" "$host" || return 1
		printf "Created profile '%s' → %s\n" "$name" "$link"
	else
		d="$(gh_dir "$name")"
		mkdir -p "$d" || return 1
		chmod 700 "$(profile_dir "$name")" 2>/dev/null
		[ -f "$(gh_config)/config.yml" ] && cp "$(gh_config)/config.yml" "$d/config.yml"

		printf "Logging in to a new account for profile '%s'...\n\n" "$name"
		if ! GH_CONFIG_DIR="$d" gh auth login --hostname "$host" "$@"; then
			err "login failed — removing empty profile '$name'"
			rm -rf -- "$(profile_dir "$name")"
			return 1
		fi
		printf "\nCreated profile '%s' → %s\n" "$name" "$(summary "$name")"
	fi

	[ -n "$(default_profile)" ] || printf '%s\n' "$name" >"$SGH_HOME/default"
	printf 'Use it here with: sgh switch %s\n' "$name"
	return 0
}

cmd_delete() {
	name="${1:-}" force=0 logout=0
	[ $# -gt 0 ] && shift
	while [ $# -gt 0 ]; do
		case "$1" in
		-y | --yes | -f | --force) force=1 ;;
		--logout) logout=1 ;;
		esac
		shift
	done

	if ! valid_name "$name" || ! exists "$name"; then
		err "no such profile: $name"
		return 1
	fi

	if [ "$force" -ne 1 ]; then
		if [ ! -t 0 ]; then
			err "refusing to delete without a terminal — pass --yes"
			return 1
		fi
		printf "Delete profile '%s' (%s)? [y/N] " "$name" "$(summary "$name")"
		read -r ans
		case "$ans" in
		y | Y | yes | YES) ;;
		*)
			printf 'Cancelled.\n'
			return 1
			;;
		esac
	fi

	# Credentials stay in the keyring by default: another profile may point at the same
	# account, and revoking the token would break that one too.
	if [ "$logout" -eq 1 ]; then
		GH_CONFIG_DIR="$(gh_dir "$name")" gh auth logout 2>/dev/null
	fi

	rm -rf -- "$(profile_dir "$name")"
	[ "$(default_profile)" = "$name" ] && rm -f "$SGH_HOME/default"

	printf "Deleted profile '%s'.\n" "$name"
	[ "$logout" -eq 1 ] ||
		printf 'Its credentials are still in your keyring (--logout removes them too).\n'
	if [ "${SGH_PROFILE:-}" = "$name" ]; then
		printf 'This terminal still points at it — run: sgh switch none\n'
	fi
	return 0
}

cmd_default() {
	if [ "${1:-}" = "--clear" ]; then
		rm -f "$SGH_HOME/default"
		printf 'Cleared. New terminals will use the default gh config.\n'
		return 0
	fi
	if [ -z "${1:-}" ]; then
		d="$(default_profile)"
		printf '%s\n' "${d:-(none)}"
		return 0
	fi
	if ! valid_name "$1" || ! exists "$1"; then
		err "no such profile: $1"
		return 1
	fi
	printf '%s\n' "$1" >"$SGH_HOME/default"
	printf "New terminals will start as '%s'.\n" "$1"
	return 0
}

cmd_exec() {
	name="${1:-}"
	[ $# -gt 0 ] && shift
	[ "${1:-}" = "--" ] && shift

	if ! valid_name "$name" || ! exists "$name"; then
		err "usage: sgh exec <name> -- <command> [args...]"
		return 1
	fi
	if [ $# -eq 0 ]; then
		err "nothing to run: sgh exec $name -- <command>"
		return 1
	fi

	GH_CONFIG_DIR="$(gh_dir "$name")" SGH_PROFILE="$name" exec "$@"
}

cmd_import() {
	src="$(gh_config)/hosts.yml"
	if [ ! -f "$src" ]; then
		err "nothing to import — no accounts in $(gh_config)"
		return 1
	fi

	imported=0
	# A heredoc keeps the loop in this shell, so `imported` survives it.
	while IFS=' ' read -r login host; do
		[ -n "$login" ] || continue
		name="$(printf '%s' "$login" | tr -c 'A-Za-z0-9._-' '-')"
		if exists "$name"; then
			printf "  skip    %-22s profile '%s' already exists\n" "$login" "$name"
			continue
		fi
		if link_profile "$name" "$login" "$host"; then
			printf "  import  %-22s → profile '%s'\n" "$login" "$name"
			imported=$((imported + 1))
		fi
	done <<EOF
$(accounts "$(gh_config)")
EOF

	if [ "$imported" -eq 0 ]; then
		printf 'Nothing new to import.\n\n'
	else
		printf '\nImported %s profile(s). Existing tokens were reused, so no new\n' "$imported"
		printf 'login is needed unless gh reports one as expired.\n\n'
	fi
	cmd_list
	return 0
}

# ── the shell hook ────────────────────────────────────────────────────

# Print shell code for the caller to eval. This is how `switch` reaches back into the
# terminal: the function installed by `sgh init` runs this and evals the result.
cmd_shellcode() {
	shell="${1:-sh}"
	[ $# -gt 0 ] && shift
	sub="${1:-}"
	[ $# -gt 0 ] && shift

	case "$sub" in
	switch | use | sw) ;;
	*)
		err "internal: unknown shellcode request '$sub'"
		return 1
		;;
	esac

	name="${1:-}"
	if [ -z "$name" ]; then
		err "usage: sgh switch <name>   (or 'none' for the plain gh config)"
		list_names >&2
		return 1
	fi

	if [ "$name" = none ] || [ "$name" = off ]; then
		case "$shell" in
		fish) printf 'set -e GH_CONFIG_DIR; set -e SGH_PROFILE\n' ;;
		*) printf 'unset GH_CONFIG_DIR SGH_PROFILE\n' ;;
		esac
		return 0
	fi

	if ! valid_name "$name" || ! exists "$name"; then
		err "no such profile: $name"
		return 1
	fi

	d="$(gh_dir "$name")"
	env_sh="$(profile_dir "$name")/env.sh"
	env_fish="$(profile_dir "$name")/env.fish"

	if [ "$shell" = fish ]; then
		printf 'set -gx GH_CONFIG_DIR %s\n' "$(fishquote "$d")"
		printf 'set -gx SGH_PROFILE %s\n' "$(fishquote "$name")"
		# env.sh is POSIX and fish cannot source it; fish users get env.fish instead.
		[ -f "$env_fish" ] && printf 'source %s\n' "$(fishquote "$env_fish")"
	else
		printf 'GH_CONFIG_DIR=%s; SGH_PROFILE=%s; export GH_CONFIG_DIR SGH_PROFILE\n' \
			"$(shquote "$d")" "$(shquote "$name")"
		[ -f "$env_sh" ] && printf '. %s\n' "$(shquote "$env_sh")"
	fi
	return 0
}

# The completion function itself. Two consumers want it wrapped differently: `init`
# registers it inline in a live shell, while `completions` prints the standalone file a
# package manager drops into fpath or bash-completion.d.
completion_body() {
	case "$1" in
	bash)
		cat <<'BASH'
_sgh_complete_bash() {
	local cur prev
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"
	if [ "$COMP_CWORD" -eq 1 ]; then
		COMPREPLY=( $(compgen -W "$(command sgh __commands)" -- "$cur") )
	else
		case "$prev" in
			switch|use|sw|delete|rm|remove|default|exec|run)
				COMPREPLY=( $(compgen -W "$(command sgh __profiles) none" -- "$cur") ) ;;
			init|completions)
				COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") ) ;;
			*) COMPREPLY=() ;;
		esac
	fi
}
BASH
		;;
	zsh)
		cat <<'ZSH'
_sgh_complete_zsh() {
	if (( CURRENT == 2 )); then
		compadd ${=$(command sgh __commands)}
	else
		case "${words[2]}" in
			switch|use|sw|delete|rm|remove|default|exec|run)
				compadd ${(f)"$(command sgh __profiles)"} none ;;
			init|completions) compadd bash zsh fish ;;
		esac
	fi
}
ZSH
		;;
	fish)
		cat <<'FISH'
function __sgh_needs_profile
	set -l cmd (commandline -opc)
	test (count $cmd) -eq 2; and contains -- $cmd[2] switch use sw delete rm remove default exec run
end
complete -c sgh -f
complete -c sgh -n 'test (count (commandline -opc)) -eq 1' -a '(command sgh __commands)'
complete -c sgh -n __sgh_needs_profile -a '(command sgh __profiles) none'
FISH
		;;
	esac
	return 0
}

# Inline registration, for `init` in a live shell.
completion_inline() {
	case "$1" in
	bash)
		completion_body bash
		printf 'complete -F _sgh_complete_bash sgh\n'
		;;
	zsh)
		# compdef only exists once compinit has run, which never happens in a
		# non-interactive shell — guard it or `eval "$(sgh init zsh)"` errors.
		printf 'if whence compdef >/dev/null 2>&1; then\n'
		completion_body zsh
		printf 'compdef _sgh_complete_zsh sgh\nfi\n'
		;;
	fish) completion_body fish ;;
	esac
	return 0
}

# Standalone completion file, for package managers.
cmd_completions() {
	case "${1:-}" in
	bash)
		completion_body bash
		printf 'complete -F _sgh_complete_bash sgh\n'
		;;
	zsh)
		# An autoloaded fpath file needs the #compdef tag and must call itself.
		printf '#compdef sgh\n'
		completion_body zsh
		printf '_sgh_complete_zsh "$@"\n'
		;;
	fish) completion_body fish ;;
	*)
		err "usage: sgh completions <bash|zsh|fish>"
		return 1
		;;
	esac
	return 0
}

cmd_init() {
	shell="${1:-}"
	case "$shell" in
	bash | zsh | sh | dash | ksh | fish) ;;
	'')
		err "usage: sgh init <bash|zsh|fish>"
		return 1
		;;
	*)
		err "unsupported shell: $shell (try bash, zsh or fish)"
		return 1
		;;
	esac

	if [ "$shell" = fish ]; then
		cat <<FISH
# sgh shell hook — generated by \`sgh init fish\`
function sgh
	switch "\$argv[1]"
		case switch use sw
			set -l __sgh_code (command sgh __shellcode fish \$argv)
			or return \$status
			printf '%s\n' \$__sgh_code | source
			and command sgh who
		case '*'
			command sgh \$argv
	end
end
FISH
	else
		cat <<'POSIX'
# sgh shell hook — generated by `sgh init`
sgh() {
	case "${1:-}" in
	switch | use | sw)
		__sgh_code="$(command sgh __shellcode sh "$@")"
		__sgh_rc=$?
		if [ "$__sgh_rc" -eq 0 ]; then
			eval "$__sgh_code"
			command sgh who
		fi
		unset __sgh_code
		return $__sgh_rc
		;;
	*) command sgh "$@" ;;
	esac
}
POSIX
	fi

	# The boot exports are computed now, but guarded at eval time so an inherited
	# profile (subshells, tmux panes, `exec zsh`) always wins over the default.
	def="$(default_profile)"
	if [ -n "$def" ] && exists "$def"; then
		if [ "$shell" = fish ]; then
			printf '\nif not set -q SGH_PROFILE\n'
			cmd_shellcode fish switch "$def" | sed 's/^/    /'
			printf 'end\n'
		else
			printf '\nif [ -z "${SGH_PROFILE:-}" ]; then\n'
			cmd_shellcode sh switch "$def" | sed 's/^/    /'
			printf 'fi\n'
		fi
	fi

	case "$shell" in
	bash | zsh | fish)
		printf '\n'
		completion_inline "$shell"
		;;
	esac
	return 0
}

cmd_help() {
	cat <<EOF
sgh $SGH_VERSION — a different GitHub account in every terminal.

USAGE
  sgh <command> [args]

COMMANDS
  list                       Show every profile; * marks this terminal's
  switch <name>              Point THIS terminal at a profile (alias: use)
  switch none                Fall back to the plain gh config
  who [-q]                   Show the account this terminal is using
  add <name> [flags]         Create a profile and log in to it
  add <name> --link <login>  Create a profile from an account already in your
                             keyring — no new login
  delete <name> [--logout]   Remove a profile (alias: rm)
  default [<name>|--clear]   Profile that new terminals start as
  exec <name> -- <cmd>       Run one command as that account, no switching
  import                     Turn your existing gh logins into profiles
  path                       Print the gh config dir this terminal uses
  init <bash|zsh|fish>       Print the shell hook (see SETUP)
  completions <shell>        Print completions only
  help | version

SETUP
  sgh switch has to change the environment of the shell you are typing in, which
  no program can do to its parent. Add the hook to your shell rc:

    bash/zsh   eval "\$(sgh init zsh)"
    fish       sgh init fish | source

  Everything except switch works without it.

EXAMPLES
  sgh import                       # first run: migrate what you already have
  sgh add personal                 # log in to another account
  sgh switch work                  # this terminal is work from now on
  sgh exec personal -- gh repo list
  sgh delete old-client --logout

  Show the profile in your prompt:
    zsh    RPROMPT='\$(sgh who -q)'
    bash   PS1="\$PS1\\\$(sgh who -q) "

  Per-profile git identity — put this in
  $(tilde "$SGH_HOME")/profiles/<name>/env.sh (env.fish for fish):
    export GIT_AUTHOR_EMAIL=you@example.com
    export GIT_COMMITTER_EMAIL=you@example.com

HOW IT WORKS
  Each profile is its own gh config dir under $(tilde "$SGH_HOME")/profiles/.
  Switching sets \$GH_CONFIG_DIR, which is per-process — so terminals never fight
  over one active account. This covers gh commands and plain https git clone/push,
  because git's credential helper is gh itself. SSH remotes are unaffected: there
  your SSH key decides.
EOF
	return 0
}

no_hook_hint() {
	err "switch needs the shell hook, which is not installed in this shell"
	printf '\nAdd this to your shell rc, then open a new terminal:\n\n' >&2
	printf '  bash/zsh   eval "$(sgh init zsh)"\n' >&2
	printf '  fish       sgh init fish | source\n\n' >&2
	printf 'Without it, no program can change the account of the shell you are\n' >&2
	printf 'typing in. To run a single command as another account instead:\n\n' >&2
	printf '  sgh exec <name> -- <command>\n' >&2
	return 1
}

# ── entrypoint ────────────────────────────────────────────────────────

mkdir -p "$SGH_HOME/profiles" 2>/dev/null

cmd="${1:-who}"
[ $# -gt 0 ] && shift

case "$cmd" in
ls | list) cmd_list "$@" ;;
who | current | status) cmd_who "$@" ;;
add | new | login) cmd_add "$@" ;;
rm | remove | delete) cmd_delete "$@" ;;
default) cmd_default "$@" ;;
exec | run) cmd_exec "$@" ;;
import) cmd_import "$@" ;;
init) cmd_init "$@" ;;
completions) cmd_completions "$@" ;;
path) printf '%s\n' "${GH_CONFIG_DIR:-$(gh_config)}" ;;
help | -h | --help) cmd_help ;;
version | -v | --version) printf 'sgh %s\n' "$SGH_VERSION" ;;
use | switch | sw) no_hook_hint ;;
__shellcode) cmd_shellcode "$@" ;;
__commands) printf '%s\n' "$SGH_COMMANDS" ;;
__profiles) list_names ;;
*)
	err "unknown command: $cmd"
	printf "Try 'sgh help'.\n" >&2
	exit 1
	;;
esac
